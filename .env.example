# DeFi Research Enhanced - Environment Configuration
# Copy this to .env and fill in your values

# RPC Configuration
ALCHEMY_API_KEY=your_api_key

# Chain ID (1=Ethereum, 56=BSC, 137=Polygon, 8453=Base, 42161=Arbitrum, 324=zkSync)
CHAIN_ID=1

# Optional: ArbExec contract for exact profit simulation
# ARB_EXEC_ADDRESS=0x...

# Minimum profit threshold (USD)
MIN_PROFIT_USD=1.0

# Report interval (blocks)
REPORT_INTERVAL_BLOCKS=50

# Max cycle hops for arbitrage detection
MAX_HOPS=4

# Minimum pool liquidity (USD)
MIN_POOL_LIQUIDITY_USD=10000

# Native token price (fallback)
NATIVE_TOKEN_PRICE_USD=3000.0

# Directories
LOG_DIR=./logs
CACHE_DIR=./cache

# Rate limiting
MAX_RPC_RPS=10.0
MAX_CONCURRENT_REQUESTS=50

# Mempool settings
MEMPOOL_MAX_FPS=5.0
MEMPOOL_QUEUE_SIZE=500

# Price oracle settings  
PRICE_CACHE_TTL=60.0
PRICE_UPDATE_INTERVAL=300.0

# Crawler settings
CRAWLER_V3_CHUNK=10
CRAWLER_V2_BATCH=20
CRAWLER_TICK_SLEEP=0.5
STALE_REFRESH_INTERVAL=3600

# Gas estimation
DEFAULT_GAS_UNITS=350000
GAS_MULTIPLIER=1.2

