# Runtime dependencies for the DeFi arbitrage research system.
#
# This is the human-maintained INPUT file; the pinned lock is requirements.txt.
# After editing, regenerate the lock with pip-tools==7.6.2 on Python 3.11
# (the exact version used to generate the committed locks):
#
#   python -m piptools compile --generate-hashes --strip-extras \
#       -o requirements.txt requirements.in
#
# Decision record for the version ranges: docs/DEPENDENCIES.md

# --- blockchain stack --------------------------------------------------------
# web3 6.x is required by the Flashbots provider distribution: flashbots 2.x
# declares web3<7,>=6 and no flashbots release supports web3 7. The previous
# web3>=7 range made the `flashbots` import in executor/executor.py structurally
# impossible. Downgrading was verified test-neutral: identical suite results
# (86 passed / 23 failed / 1 error) under web3 7.16.0 and web3 6.20.4.
web3>=6.20,<7
# Official Flashbots provider for web3.py (https://pypi.org/project/flashbots/).
# Supplies FlashbotsWeb3 + flashbot() — the exact symbols guarded by
# executor/executor.py — and the w3.flashbots.* methods used by
# executor/relay.py (send_bundle / simulate / cancel_bundles /
# send_private_transaction).
flashbots>=2.0,<3
# Directly imported (executor/, execution/, optimizer/, protocols/, crawler):
eth-account>=0.8,<0.13      # web3 6.x caps eth-account<0.13 (previous range assumed web3 7)
eth-abi>=4                  # web3 6.x allows eth-abi 4..6
eth-utils>=2.1,<5           # web3 6.x caps eth-utils<5
hexbytes>=0.1,<0.4          # web3 6.x caps hexbytes<0.4 (only isinstance/HexBytes used)
rlp>=3,<6                   # direct import in utils/serializer.py

# --- transports ---------------------------------------------------------------
websockets>=12,<14          # mempool/watcher.py; web3 6.x caps websockets<14
aiohttp>=3.9,<4             # prices.py
httpx>=0.27,<1              # utils/graph_client.py, protocols/{balancer,curve}.py
requests>=2.31,<3           # detectors/cycles.py, tvl.py, utils/gecko_terminal.py

# --- runtime utilities --------------------------------------------------------
python-dotenv>=1.0,<2       # config/.env loading
nest-asyncio>=1.6,<2        # cache.py nested event-loop patching

# --- reporting ----------------------------------------------------------------
pandas>=2.0,<3              # reporter.py
matplotlib>=3.8,<4          # reporter.py charts
